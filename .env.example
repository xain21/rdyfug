# Copy this file to `.env` (same folder as manage.py) and fill in real values.
# `.env` should NEVER be committed to version control or shared - it holds
# your real secret key.

# Generate a fresh one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-to-a-long-random-value

# True while developing on your own machine. Set to False before letting
# anyone else access this (it currently defaults to True to match previous
# behavior, but you MUST set this to False for any shared/production use -
# debug mode exposes file paths, settings, and database queries in error
# pages).
DJANGO_DEBUG=True

# Comma-separated, no spaces. Add every hostname/IP:port this will be
# reached at.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,172.16.17.100,172.16.17.168:1111,165.99.50.65,bod.wsspeshawar.org.pk:4003,bod.wsspeshawar.org.pk

# Only relevant once DJANGO_DEBUG=False. Leave as True if you're serving
# over HTTPS (recommended). Set to False only if you deliberately don't
# have HTTPS set up yet (not recommended).
DJANGO_CSRF_COOKIE_SECURE=True
DJANGO_SESSION_COOKIE_SECURE=True

# Optional. Only needed for the "Auto-Extract Meeting" upload feature
# (/auto-extract/). If left blank, that page still works using a free
# pattern-based extractor - it just won't have the smarter AI parsing for
# messy/inconsistent documents. Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# --- Email notifications ("new document uploaded" alerts) -----------------
# Optional. If left blank, emails are just printed to the console/server
# log instead of actually being sent - safe default, nothing breaks.
# To send real emails, fill these in with your organization's SMTP details
# (ask your email/IT admin - for Gmail this is smtp.gmail.com port 587 with
# an App Password, not your normal password).
DJANGO_EMAIL_HOST=
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_USE_TLS=True
DJANGO_DEFAULT_FROM_EMAIL=noreply@bod-portal.local
